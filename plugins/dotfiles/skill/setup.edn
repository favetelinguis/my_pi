{:schema-version 1
 :platforms [:linux :macos]
 :file-limit-bytes 2097152
 :files
 [{:id "mise.config" :asset "assets/configs/mise/config.toml"
   :target ".config/mise/config.toml" :ignore-comments true
   :priority 1 :remediation "Back up and merge the complete bundled mise config, preserving all tools and settings; review before running mise install."}
  {:id "ghostty.config" :asset "assets/configs/ghostty/config"
   :target ".config/ghostty/config" :ignore-comments true
   :priority 2 :remediation "Back up and merge the Ghostty baseline. On macOS also inspect the native Application Support config for conflicting overrides; verify shortcuts manually."}
  {:id "herdr.config" :asset "assets/configs/herdr/config.toml"
   :target ".config/herdr/config.toml" :ignore-comments true
   :priority 2 :remediation "Back up and merge Herdr settings. Preserve unrelated local preferences; verify Ctrl-T prefix and reviewr toggle after separate approval."}
  {:id "reviewr.config" :asset "assets/configs/herdr/reviewr.toml"
   :target ".config/herdr/plugins/config/persiyanov.reviewr/config.toml" :ignore-comments true
   :priority 2 :remediation "Back up and merge reviewr's github-light theme in its own configuration, not Herdr's main config."}
  {:id "emacs.init" :asset "assets/configs/emacs/init.el" :target ".emacs.d/init.el"
   :priority 2 :remediation "Review the bundled Emacs 31 init and back up the existing init before merging. First launch bootstraps Elpaca over the network; do not run it during audit."}
  {:id "emacs.early-init" :asset "assets/configs/emacs/early-init.el" :target ".emacs.d/early-init.el"
   :priority 2 :remediation "Back up and merge the terminal-only Elpaca early-init settings."}
  {:id "shell.common" :asset "assets/configs/shell/common.sh" :target ".config/my-pi/shell/common.sh"
   :priority 2 :remediation "Deploy this reviewed shared fragment alongside the Bash/Zsh fragments; review PATH, editor and pit aliases."}
  {:id "shell.zsh" :asset "assets/configs/shell/zshrc" :target ".config/my-pi/shell/zshrc"
   :priority 2 :remediation "Deploy the curated Zsh fragment, then merge its source hook into ~/.zshrc once. Remove older competing prompt/tool initialization and wtc/wt integration."}
  {:id "shell.bash" :asset "assets/configs/shell/bashrc" :target ".config/my-pi/shell/bashrc"
   :priority 2 :remediation "Deploy the curated Bash fragment, then merge its source hook into ~/.bashrc once. Remove older competing prompt/tool initialization and wt integration."}
  {:id "pi.global" :asset "assets/pi/AGENTS.md" :target ".pi/agent/AGENTS.md" :comparison :presence
   :priority 2 :remediation "If absent or empty, install the bundled global instructions after approval and adapt the repository path for this machine. If present, preserve it: machine-specific content differences are allowed and should be noted in the review, not flagged as drift."}
  {:id "pi.team" :asset "assets/pi/team/TEAM.md" :target ".pi/agent/team/TEAM.md"
   :priority 2 :remediation "Restore the reviewed TEAM.md at the path referenced by pit and role launch commands. Do not add it to auto-loaded global context."}
  {:id "pi.orchestrator" :asset "assets/pi/orchestrator/SYSTEM.md" :target ".pi/agent/orchestrator/SYSTEM.md"
   :priority 2 :remediation "Restore the reviewed orchestrator prompt. Select it explicitly with --append-system-prompt; never auto-launch a team as part of setup audit."}
  {:id "pi.planner" :asset "assets/pi/planner/SYSTEM.md" :target ".pi/agent/planner/SYSTEM.md"
   :priority 2 :remediation "Restore the reviewed planner prompt and select it explicitly in role launch commands."}
  {:id "pi.implementer" :asset "assets/pi/implementer/SYSTEM.md" :target ".pi/agent/implementer/SYSTEM.md"
   :priority 2 :remediation "Restore the reviewed implementer prompt and select it explicitly in role launch commands."}
  {:id "pi.reviewer" :asset "assets/pi/reviewer/SYSTEM.md" :target ".pi/agent/reviewer/SYSTEM.md"
   :priority 2 :remediation "Restore the reviewed reviewer prompt and select it explicitly in role launch commands."}
  {:id "pi.tester" :asset "assets/pi/tester/SYSTEM.md" :target ".pi/agent/tester/SYSTEM.md"
   :priority 2 :remediation "Restore the reviewed tester prompt and select it explicitly in role launch commands."}
  {:id "pi.herdr-skill" :asset "assets/pi/herdr.md" :target ".pi/agent/skills/herdr.md"
   :priority 2 :remediation "Restore the Herdr skill required by the orchestrator; keep its explicit Herdr routing and managed-pane safety rules."}]
